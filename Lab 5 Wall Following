/*
 * Arduino sketch for a 2-wheel robot with a Servo-based Ultrasonic Sweep.
 * CORE FEATURE: Autonomous Sweep-based Navigation (AUTONOMOUS_SWEEP_MODE)
 * - Moves forward until distance < 35 cm.
 * - Stops and performs a sweep scan from 20 to 160 degrees to find the widest open path.
 * - Pivots the robot to face that new, clear direction.
 */

#include <Servo.h>

// --- Pin Definitions for L298N Motor Driver ---
#define leftMotorEnable 9   // ENA (PWM)
#define leftMotorIn1    8   // IN1
#define leftMotorIn2    7   // IN2

#define rightMotorIn1   13  // IN3
#define rightMotorIn2   12  // IN4
#define rightMotorEnable 11 // ENB (PWM)

// --- Ultrasonic Front Sensor ---
#define ULTRASONIC_TRIG 3
#define ULTRASONIC_ECHO 2

// --- Servo for Sweep ---
#define SERVO_PIN 5
Servo sweepServo; // Servo object to control the sweeping sensor

// --- Control & Configuration ---
const int motorSpeed = 70;         // Base speed for motors (0-255)
const float turnFactor = 0.5;       // Used for gentle turns (not pivots)
const int commandTimeout = 250;     // Timeout for manual commands

// Autonomous front-distance hold settings
const float SWEEP_TRIGGER_CM = 35.0;  // Distance to trigger a full sweep
const float HYSTERESIS = 2.0;         // Small buffer
const unsigned long SENSOR_PERIOD_MS = 100; // How often to recheck distance
const unsigned long PULSE_TIMEOUT_US = 25000; // 25 ms timeout for pulseIn

// Sweep parameters
const int SWEEP_START_ANGLE = 20;
const int SWEEP_END_ANGLE = 160;
const int ANGLE_STEP = 10;
const int CENTER_ANGLE = 90;

unsigned long lastCommandTime = 0;
bool isStopped = true;

unsigned long lastSensorReadMs = 0;
float lastDistanceCm = NAN;

// Mode toggles
const bool AUTONOMOUS_SWEEP_MODE = true;
const bool AUTONOMOUS_FRONT_HOLD = false;

// ===============================================================
// SETUP AND MAIN LOOP
// ===============================================================
void setup() {
  Serial.begin(115200);
  Serial.println("Robot is ready.");

  // Motor pins setup
  pinMode(rightMotorEnable, OUTPUT);
  pinMode(rightMotorIn1, OUTPUT);
  pinMode(rightMotorIn2, OUTPUT);
  pinMode(leftMotorEnable, OUTPUT);
  pinMode(leftMotorIn1, OUTPUT);
  pinMode(leftMotorIn2, OUTPUT);

  // Ultrasonic pins setup
  pinMode(ULTRASONIC_TRIG, OUTPUT);
  pinMode(ULTRASONIC_ECHO, INPUT);
  digitalWrite(ULTRASONIC_TRIG, LOW);

  // Servo setup
  sweepServo.attach(SERVO_PIN);
  sweepServo.write(CENTER_ANGLE);
  delay(500);

  stopMotors();
  delay(50);

  if (AUTONOMOUS_SWEEP_MODE) {
    Serial.println("Mode: Autonomous Sweep-based Navigation");
    Serial.println("Behavior: Drive forward until < 35cm, then sweep to find new path.");
  } else if (AUTONOMOUS_FRONT_HOLD) {
    Serial.println("Mode: Autonomous front-distance hold");
  } else {
    Serial.println("Mode: Manual serial (w a s d). Combine keys like 'wd'.");
  }
}

void loop() {
  if (AUTONOMOUS_SWEEP_MODE) {
    autonomousSweepNavigation();
  } else if (AUTONOMOUS_FRONT_HOLD) {
    autonomousFrontHoldLoop();
  } else {
    manualSerialControlLoop();
  }
}

// ===============================================================
// SWEEP-BASED NAVIGATION
// ===============================================================
void autonomousSweepNavigation() {
  const unsigned long now = millis();

  if (now - lastSensorReadMs >= SENSOR_PERIOD_MS) {
    lastSensorReadMs = now;

    sweepServo.write(CENTER_ANGLE);
    delay(50);
    lastDistanceCm = measureDistanceCm();

    if (isnan(lastDistanceCm) || lastDistanceCm > (SWEEP_TRIGGER_CM + HYSTERESIS)) {
      moveForward(motorSpeed);
      if (isStopped) {
        Serial.print("Moving Forward. Distance: ");
        Serial.print(lastDistanceCm, 1);
        Serial.println(" cm");
        isStopped = false;
      }
    } else {
      stopMotors();
      if (!isStopped) {
        Serial.println("--- Obstacle Detected! Starting Sweep ---");
        isStopped = true;
      }

      int bestAngle = performSweepAndDecide();

      if (bestAngle != -1) {
        executeTurn(bestAngle);
      } else {
        Serial.println("ERROR: No clear path found, attempting a random turn.");
        pivotRight(motorSpeed);
        delay(500);
        stopMotors();
      }
    }
  }
}

void executeTurn(int bestAngle) {
  int angleDiff = bestAngle - CENTER_ANGLE;
  int turnDurationMs = abs(angleDiff) * 5;

  Serial.print("Turning by approx. ");
  Serial.print(abs(angleDiff));
  Serial.print(" degrees (Duration: ");
  Serial.print(turnDurationMs);
  Serial.println("ms)");

  if (angleDiff > 5) {
    pivotLeft(motorSpeed);
    delay(turnDurationMs);
  } else if (angleDiff < -5) {
    pivotRight(motorSpeed);
    delay(turnDurationMs);
  } else {
    Serial.println("Already facing the best direction.");
  }

  stopMotors();
  Serial.println("Turn complete. Resuming forward movement.");
}

int performSweepAndDecide() {
  float maxDistance = 0.0;
  int bestAngle = -1;

  for (int angle = SWEEP_START_ANGLE; angle <= SWEEP_END_ANGLE; angle += ANGLE_STEP) {
    sweepServo.write(angle);
    delay(100);

    float dist = measureDistanceCm();

    Serial.print("SWEEP: Angle ");
    Serial.print(angle);
    Serial.print(" degrees: ");
    if (isnan(dist)) {
      Serial.println("No Echo");
    } else {
      Serial.print(dist, 1);
      Serial.println(" cm");
    }

    if (!isnan(dist) && dist > maxDistance) {
      maxDistance = dist;
      bestAngle = angle;
    }
  }

  sweepServo.write(CENTER_ANGLE);
  delay(500);

  if (bestAngle != -1) {
    Serial.print("DECISION: Best path found at ");
    Serial.print(bestAngle);
    Serial.print(" degrees with ");
    Serial.print(maxDistance, 1);
    Serial.println(" cm clearance.");
  }

  return bestAngle;
}

// ===============================================================
// HELPER FUNCTIONS
// ===============================================================
float measureDistanceCm() {
  digitalWrite(ULTRASONIC_TRIG, LOW);
  delayMicroseconds(2);
  digitalWrite(ULTRASONIC_TRIG, HIGH);
  delayMicroseconds(10);
  digitalWrite(ULTRASONIC_TRIG, LOW);

  unsigned long duration = pulseIn(ULTRASONIC_ECHO, HIGH, PULSE_TIMEOUT_US);
  if (duration == 0) return NAN;

  float cm = (duration * 0.0343f) / 2.0f;
  if (cm < 1.0f || cm > 400.0f) return NAN;
  return cm;
}

void setMotorSpeeds(int leftSpeed, int rightSpeed) {
  if (leftSpeed > 0) {
    digitalWrite(leftMotorIn1, HIGH);
    digitalWrite(leftMotorIn2, LOW);
  } else if (leftSpeed < 0) {
    digitalWrite(leftMotorIn1, LOW);
    digitalWrite(leftMotorIn2, HIGH);
  } else {
    digitalWrite(leftMotorIn1, LOW);
    digitalWrite(leftMotorIn2, LOW);
  }
  analogWrite(leftMotorEnable, abs(leftSpeed));

  if (rightSpeed > 0) {
    digitalWrite(rightMotorIn1, LOW);
    digitalWrite(rightMotorIn2, HIGH);
  } else if (rightSpeed < 0) {
    digitalWrite(rightMotorIn1, HIGH);
    digitalWrite(rightMotorIn2, LOW);
  } else {
    digitalWrite(rightMotorIn1, LOW);
    digitalWrite(rightMotorIn2, LOW);
  }
  analogWrite(rightMotorEnable, abs(rightSpeed));
}

void stopMotors() { setMotorSpeeds(0, 0); }
void moveForward(int speed) { setMotorSpeeds(speed, speed); }
void moveBackward(int speed) { setMotorSpeeds(-speed, -speed); }
void pivotLeft(int speed) { setMotorSpeeds(-speed, speed); }
void pivotRight(int speed) { setMotorSpeeds(speed, -speed); }
void turnForwardLeft(int speed) { setMotorSpeeds(speed * turnFactor, speed); }
void turnForwardRight(int speed) { setMotorSpeeds(speed, speed * turnFactor); }
void turnBackwardLeft(int speed) { setMotorSpeeds(-speed * turnFactor, -speed); }
void turnBackwardRight(int speed) { setMotorSpeeds(-speed, -speed * turnFactor); }

// ===============================================================
// AUTONOMOUS FRONT DISTANCE HOLD MODE
// ===============================================================
void autonomousFrontHoldLoop() {
  const unsigned long now = millis();

  if (now - lastSensorReadMs >= SENSOR_PERIOD_MS) {
    lastSensorReadMs = now;

    sweepServo.write(CENTER_ANGLE);
    delay(50);

    lastDistanceCm = measureDistanceCm();

    if (isnan(lastDistanceCm)) {
      stopMotors();
      if (!isStopped) {
        Serial.println("No echo. Stopping for safety.");
        isStopped = true;
      }
      return;
    }

    const float FRONT_HOLD_SETPOINT = 25.0;

    if (lastDistanceCm > (FRONT_HOLD_SETPOINT + HYSTERESIS)) {
      moveForward(motorSpeed);
      if (isStopped) {
        Serial.print("Forward: ");
        Serial.print(lastDistanceCm, 1);
        Serial.println(" cm from wall");
        isStopped = false;
      }
    } else {
      stopMotors();
      if (!isStopped) {
        Serial.print("Stop: ");
        Serial.print(lastDistanceCm, 1);
        Serial.print(" cm <= ");
        Serial.print(FRONT_HOLD_SETPOINT, 1);
        Serial.println(" cm");
        isStopped = true;
      }
    }
  }
}

// ===============================================================
// MANUAL SERIAL CONTROL MODE
// ===============================================================
void manualSerialControlLoop() {
  if (Serial.available() > 0) {
    bool isMovingForward = false;
    bool isMovingBackward = false;
    bool isTurningLeft = false;
    bool isTurningRight = false;

    lastCommandTime = millis();
    isStopped = false;

    while (Serial.available() > 0) {
      char command = Serial.read();
      switch (command) {
        case 'w': isMovingForward = true; break;
        case 's': isMovingBackward = true; break;
        case 'a': isTurningLeft = true; break;
        case 'd': isTurningRight = true; break;
      }
    }

    if (isMovingForward && isTurningLeft) {
      turnForwardLeft(motorSpeed);
    } else if (isMovingForward && isTurningRight) {
      turnForwardRight(motorSpeed);
    } else if (isMovingBackward && isTurningLeft) {
      turnBackwardLeft(motorSpeed);
    } else if (isMovingBackward && isTurningRight) {
      turnBackwardRight(motorSpeed);
    } else if (isMovingForward) {
      moveForward(motorSpeed);
    } else if (isMovingBackward) {
      moveBackward(motorSpeed);
    } else if (isTurningLeft) {
      pivotLeft(motorSpeed);
    } else if (isTurningRight) {
      pivotRight(motorSpeed);
    } else {
      stopMotors();
      isStopped = true;
    }
  }

  if (millis() - lastCommandTime > commandTimeout && !isStopped) {
    stopMotors();
    isStopped = true;
    Serial.println("Command timeout. Motors stopped.");
  }
}
